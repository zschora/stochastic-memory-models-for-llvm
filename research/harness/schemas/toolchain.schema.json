{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zschora/stochastic-memory-models-for-llvm/research/harness/schemas/toolchain.schema.json",
  "title": "Verified LLVM toolchain provenance manifest",
  "type": "object",
  "required": [
    "schema_version", "record_type", "toolchain_id", "llvm_revision",
    "source", "build", "tools", "verification", "consistency"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "toolchain"},
    "toolchain_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9._-]{3,60}$"},
    "llvm_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "source": {
      "type": "object",
      "required": ["repository", "dir", "dirty"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "dir": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "checkout": {"type": "string"}
      }
    },
    "build": {
      "type": "object",
      "required": ["dir", "configuration", "generator", "assertions",
                   "targets", "cmake_args"],
      "properties": {
        "dir": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "assertions": {"type": "boolean"},
        "targets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "cmake_args": {"type": "array", "items": {"type": "string"}},
        "compiler": {"type": "string"},
        "cmake_cache_sha256": {"type": "string"}
      }
    },
    "tools": {
      "type": "object",
      "required": ["clang", "opt", "llc", "llvm-config"],
      "properties": {
        "clang": {"$ref": "#/$defs/tool"},
        "opt": {"$ref": "#/$defs/tool"},
        "llc": {"$ref": "#/$defs/tool"},
        "llvm-config": {"$ref": "#/$defs/tool"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["method", "verified_utc", "verified_by", "limitations"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "verified_utc": {"type": "string"},
        "verified_by": {"type": "string", "minLength": 1},
        "require_local_source": {"type": "boolean"},
        "reject_path_shadowing": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "consistency": {"enum": ["verified", "mixed", "unverified"]}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["path", "version", "version_output", "sha256",
                   "source_revision", "provenance"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_output": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "provenance": {"enum": ["local-build", "official-release-binary",
                                 "external-binary"]}
      }
    }
  },
  "additionalProperties": true
}
