@@ -61,6 +61,8 @@
 #include "llvm/Analysis/ScalarEvolutionExpressions.h"
 #include "llvm/Analysis/TargetTransformInfo.h"
 #include "llvm/IR/Function.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Metadata.h"
 #include "llvm/IR/Verifier.h"
 #include "llvm/Support/Debug.h"
 #include "llvm/Support/raw_ostream.h"
@@ -93,6 +95,8 @@ STATISTIC(
     "Loop has a non-empty preheader with instructions that cannot be moved");
 STATISTIC(InsufficientReuse,
           "Fusion has insufficient cross-loop reused values");
+STATISTIC(VectorizationConflict,
+          "Fusion would inherit incompatible vectorization metadata");
 STATISTIC(NonIdenticalGuards, "Candidates have different guards");
 STATISTIC(NonEmptyExitBlock, "Candidate has a non-empty exit block with "
                              "instructions that cannot be moved");
@@ -684,6 +688,68 @@ private:
     return ReusedValueCount >= Opts.loop_fusion_min_reused_values;
   }
 
+  /// Explicit vectorization hints attached to a loop, if any.  LoopFusion
+  /// rewires the fused loop to the second candidate's latch, so the second
+  /// loop's metadata wins; a conflict can silently discard an explicit request
+  /// from the first loop.
+  struct VectorizationHint {
+    bool Enable = false;
+    bool Disable = false;
+    bool HasWidth = false;
+    unsigned Width = 0;
+
+    bool requestsVectorization() const {
+      return Enable || (HasWidth && Width > 1);
+    }
+    bool blocksVectorization() const {
+      return Disable || (HasWidth && Width == 1);
+    }
+  };
+
+  static VectorizationHint getVectorizationHint(const Loop &L) {
+    VectorizationHint Hint;
+    MDNode *LoopID = L.getLoopID();
+    if (!LoopID)
+      return Hint;
+    for (unsigned I = 1, E = LoopID->getNumOperands(); I < E; ++I) {
+      auto *Property = dyn_cast<MDNode>(LoopID->getOperand(I));
+      if (!Property || Property->getNumOperands() == 0)
+        continue;
+      auto *Name = dyn_cast<MDString>(Property->getOperand(0));
+      if (!Name)
+        continue;
+      StringRef Key = Name->getString();
+      if (Key == "llvm.loop.vectorize.enable")
+        Hint.Enable = true;
+      else if (Key == "llvm.loop.vectorize.disable")
+        Hint.Disable = true;
+      else if (Key == "llvm.loop.vectorize.width" &&
+               Property->getNumOperands() > 1) {
+        if (auto *Width = mdconst::dyn_extract<ConstantInt>(
+                Property->getOperand(1))) {
+          Hint.HasWidth = true;
+          Hint.Width = unsigned(Width->getZExtValue());
+        }
+      }
+    }
+    return Hint;
+  }
+
+  /// A conservative metadata-only conflict check.  It deliberately does not
+  /// try to predict whether either loop will actually vectorize: it only
+  /// rejects an explicit request on the first loop that the second loop would
+  /// explicitly block or narrow.
+  bool hasVectorizationConflict(const FusionCandidate &FC0,
+                                const FusionCandidate &FC1) const {
+    VectorizationHint H0 = getVectorizationHint(*FC0.L);
+    VectorizationHint H1 = getVectorizationHint(*FC1.L);
+    if (!H0.requestsVectorization())
+      return false;
+    if (H1.blocksVectorization())
+      return true;
+    return H0.HasWidth && H1.HasWidth && H1.Width < H0.Width;
+  }
+
   /// Computes the integer difference in trip counts:
   /// TripCount(FC0) - TripCount(FC1).
   ///
@@ -968,6 +1034,15 @@ private:
           continue;
         }
 
+        if (Opts.loop_fusion_vectorization_check &&
+            hasVectorizationConflict(FC0, FC1)) {
+          ++VectorizationConflict;
+          reportLoopFusion<OptimizationRemarkMissed>(
+              FC0, FC1, "VectorizationConflict",
+              "Fusion would inherit incompatible vectorization metadata");
+          continue;
+        }
+
         // All analysis has completed and has determined that fusion is legal
         // and profitable. At this point, start transforming the code and
         // perform fusion.
